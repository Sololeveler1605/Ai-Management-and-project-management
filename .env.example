# AI Project OS — environment template
# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL=postgresql://postgres:<URL_ENCODED_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional LLM (OpenAI-compatible). Without a key, call_llm() uses a local fallback.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Groq API key — used by RAG chat answers (document Q&A).
# Get one at https://console.groq.com/
GROQ_API_KEY=

# openai-whisper local model size (base is required for Phase 2 development)
WHISPER_MODEL_SIZE=base

API_BASE_URL=http://localhost:8000
